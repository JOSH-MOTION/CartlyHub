rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isSelf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    // Orders carry three different owner fields:
    //   userId      legacy orders written by the old checkout
    //   customerId  marketplace orders — the shopper
    //   vendorId    marketplace orders — the store being bought from
    // All three are listed so vendor dashboards, customer order history and the
    // old records all keep working. Queries must filter on one of them; an
    // unfiltered list is admin-only.
    match /orders/{orderId} {
      allow read: if isAdmin()
                  || isSelf(resource.data.userId)
                  || isSelf(resource.data.customerId)
                  || isSelf(resource.data.vendorId);
      allow create: if request.resource.data.userId == 'guest'
                    || isSelf(request.resource.data.userId)
                    || isSelf(request.resource.data.customerId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || isSelf(request.resource.data.sellerId);
      allow update, delete: if isAdmin() || isSelf(resource.data.sellerId);
    }

    // A vendor may edit their own store, but only an admin may suspend or
    // verify one — otherwise a suspended vendor could lift their own ban.
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isSelf(sellerId);
      allow update: if isAdmin()
                    || (isSelf(sellerId)
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['isSuspended', 'isVerified']));
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // Two producers write here: the mobile chat service uses `recipientId`,
    // the marketplace notification service uses `userId`. Both are honoured so
    // neither has to change.
    match /notifications/{notificationId} {
      allow read: if isSelf(resource.data.recipientId) || isSelf(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isSelf(resource.data.recipientId) || isSelf(resource.data.userId);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Marketplace money.
    //
    // Read-only to the party it belongs to. Nothing here is ever writable from
    // a browser — balances, ledger rows and payout state are written only by
    // the server through the Firebase Admin SDK, which bypasses these rules.
    // If a wallet is not being credited after a payment, the server is still
    // on the web SDK; that is the cause, not these rules.
    // ---------------------------------------------------------------------

    match /wallets/{vendorId} {
      allow read: if isAdmin() || isSelf(vendorId);
      allow write: if false;
    }

    match /walletTransactions/{transactionId} {
      allow read: if isAdmin() || isSelf(resource.data.vendorId);
      allow write: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || isSelf(resource.data.vendorId);
      allow write: if false;
    }

    match /payments/{reference} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /manualSales/{saleId} {
      allow read, write: if isAdmin();
    }

    match /inventory/{productId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /reinvestments/{reinvestmentId} {
      allow read, write: if isAdmin();
    }
  }
}
